# Copy this to .env and fill in your values.
# NEVER commit the real .env file.

# ── SMTP (leave blank to run in dry-run/mock mode) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=no-reply@aicte-demo.in
MAIL_USE_TLS=true

# ── App ──────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# ── Safety ───────────────────────────────────────────────────────────────────
# Comma-separated list of email addresses that are allowed to receive real emails.
# Leave blank to allow all (DANGER in production).
# When set, any address NOT in this list will be skipped (status=skipped).
EMAIL_ALLOWLIST=sushdevop07@gmail.com

# ── Verification token expiry (hours) ───────────────────────────────────────
VERIFICATION_TOKEN_EXPIRY_HOURS=72

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (for local dev / hackathon demo)
# DATABASE_URL=postgresql://user:pass@localhost/sih_platform

